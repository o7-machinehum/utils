# Merge compile_commands.json from build dir(s) and fix paths for clangd
# Usage: wlkr_clangd_fix [target_filter]
#   e.g. wlkr_clangd_fix ray-fmu
function wlkr_clangd_fix () {
  local target=${1:-}

  if [ -n "$target" ]; then
      local files=$(find build -path "*${target}*" -name compile_commands.json)
  else
      local files=$(find build -name compile_commands.json)
  fi

  if [ -z "$files" ]; then
      echo "No compile_commands.json found"
      return 1
  fi

  echo "$files" | xargs jq -s 'add' | sed "s|/workspaces/[^/]*/PX4|$PWD|g" > compile_commands.json
  echo "Merged $(echo "$files" | wc -l) compile_commands.json from:"
  echo "$files"
}
