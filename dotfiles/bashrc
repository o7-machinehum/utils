# If not running interactively, don't do anything
[[ $- != *i* ]] && return

export PS1='\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\W\[\033[00m\]\$ '
alias ls='ls --color=auto'

# General shortcuts
alias r='ranger --choosedir=$HOME/.rangerdir; LASTDIR=`cat $HOME/.rangerdir`; cd "$LASTDIR"'
alias ranger='ranger --choosedir=$HOME/.rangerdir; LASTDIR=`cat $HOME/.rangerdir`; cd "$LASTDIR"'

# HDMI screen stuff
wlkr_hdmi_work_on() {
    xrandr --output HDMI-1 --auto
    xrandr --output HDMI-1 --above eDP-1
    # sed -i 's/size = 7.0/size = 9.0/g' ~/.config/alacritty/alacritty.toml
    conf=~/.config/alacritty/alacritty.toml
    sed -i '/^\[font\]/,/^\[/{s/^[[:space:]]*size[[:space:]]*=.*/size = 9.0/}' $conf
}

wlkr_port_mon_on() {
    xrandr --output DP-2 --auto
    xrandr --output DP-2 --above eDP-1
    # sed -i 's/size = 7.0/size = 8.0/g' ~/.config/alacritty/alacritty.toml
    conf=~/.config/alacritty/alacritty.toml
    sed -i '/^\[font\]/,/^\[/{s/^[[:space:]]*size[[:space:]]*=.*/size = 7.0/}' $conf
}

wlkr_hdmi_off() {
    xrandr --output DP-2 --off
    xrandr --output HDMI-1 --off
    # sed -i 's/size = 9.0/size = 7.0/g' ~/.config/alacritty/alacritty.toml
    conf=~/.config/alacritty/alacritty.toml
    sed -i '/^\[font\]/,/^\[/{s/^[[:space:]]*size[[:space:]]*=.*/size = 7.0/}' $conf
}

alias wlkr_hdmi_tv_on='xrandr --output HDMI-1 --auto && xrandr --output HDMI-1 --same-as eDP-1'

# CPU Power
alias wlkr_cpu_on_demand='sudo cpupower frequency-set -g ondemand'
