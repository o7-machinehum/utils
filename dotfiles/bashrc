export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR:-/tmp}/ssh-agent-$UID.sock"

# Start agent ONLY if there is no agent (exit code 2)
ssh-add -l >/dev/null 2>&1
rc=$?
if [ $rc -eq 2 ] || [ ! -S "$SSH_AUTH_SOCK" ]; then
  rm -f "$SSH_AUTH_SOCK" 2>/dev/null
  eval "$(ssh-agent -a "$SSH_AUTH_SOCK" -s)" >/dev/null
fi

# Load keys (quiet). If already loaded, ssh-add is a no-op.
ssh-add -q ~/.ssh/git_key ~/.ssh/id_ed25519 2>/dev/null

